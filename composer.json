{
  "name": "maoxtrem/asistente-ia",
  "description": "Bundle Symfony para widget de chat IA y proxy hacia un microservicio externo.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "symfony/config": "^6.4|^7.0",
    "symfony/dependency-injection": "^6.4|^7.0",
    "symfony/http-client": "^6.4|^7.0",
    "symfony/http-foundation": "^6.4|^7.0",
    "symfony/http-kernel": "^6.4|^7.0",
    "symfony/routing": "^6.4|^7.0",
    "symfony/twig-bundle": "^6.4|^7.0",
    "twig/twig": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Maoxtrem\\AsistenteIa\\": "src/"
    }
  },
  "extra": {
